{
  "name": "video",
  "version": "1.0.0",
  "description": "Motion graphics announcement film for ssher Cloud",
  "repository": "https://github.com/Johnniewhite/ssher",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.499",
    "@remotion/google-fonts": "4.0.499",
    "@remotion/media": "4.0.499",
    "@remotion/transitions": "4.0.499",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.499"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.499",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "audio": "node scripts/generate-audio.mjs",
    "build": "remotion bundle",
    "render": "remotion render SsherCloudLaunch out/ssher-cloud-launch.mp4 --codec=h264 --crf=16 --concurrency=2",
    "stills": "remotion still SsherCloudLaunch",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "sideEffects": [
    "*.css"
  ]
}
